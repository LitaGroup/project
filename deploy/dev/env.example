# LitaWork 开发验收环境后端配置模板
# 复制到 {APP_DIR}/backend/.env 后按实际环境填写；不要提交真实令牌与密码。
PORT=3100
NODE_ENV=development

# 业务库（开发环境使用本机 pgvector 容器）
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=lita_project_dev

# 知识库默认复用 DB_*；如独立部署再取消注释
# PROJECT_PG_HOST=
# PROJECT_PG_PORT=
# PROJECT_PG_USER=
# PROJECT_PG_PASSWORD=
# PROJECT_PG_DATABASE=

# 访问地址（nginx 同域反代 /api）
APP_URL=http://work-test.agent.cinta.team
API_URL=http://work-test.agent.cinta.team/api

# 登录会话签名密钥，生产/共享环境必须使用随机值
AUTH_JWT_SECRET=
COOKIE_SECURE=false

# 飞书机器人凭据加密主密钥（64 位 hex，例如 openssl rand -hex 32）
# 平台官方机器人 / 机器人独立飞书应用的 APP Secret、Verification Token、Encrypt Key 用它 AES-256-GCM 加密落库
FEISHU_BOT_MASTER_KEY=
# FEISHU_BOT_MASTER_KEY_VERSION=v1

# 飞书网页登录：平台官方机器人应用凭据保存在数据库「管理 → 飞书配置」
# （feishu_bot_configs kind=official），不再从 FEISHU_APP_ID / FEISHU_APP_SECRET 读取。
# 从旧版本升级时需在管理页重新绑定一次官方机器人，否则登录入口会提示配置缺失。

# 飞书 tenant token 来源（可选）。开发环境建议留空，避免向真实飞书群/用户发送通知
LITA_USER_TOKEN=
# LITA_API_HOST=https://api.test.cinta.team

# 脚本/静态资源目录
CHECK_SCRIPTS_DIR=/home/ecs-user/work/lita-scripts
DIR_IMAGE_WEBROOT=/home/ecs-user/work/litawork/webroot-images
DIR_EXPORT_WEBROOT=/home/ecs-user/work/litawork/export-files
DIR_FILE_WEBROOT=/home/ecs-user/work/litawork/files

# 机器人工位根目录（执行器与后端同机部署）；开发环境工位为 {WORKER_BASE_DIR}/worker-dev/{workerId}
WORKER_BASE_DIR=/home/ecs-user/runtime

# GitHub 集成（仓库/分支联想与提交监听，可选）
GITHUB_TOKEN=
GITHUB_ORG=LitaGroup

# 开发环境公共 Agent 令牌（可选；仅用于本地联调，生成方式：openssl rand -hex 24）
PUBLIC_AGENT_TOKEN=
