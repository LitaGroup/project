# 服务端口
PORT=3000
NODE_ENV=production

# MySQL（正式环境）
MYSQL_HOST=lita-test.cluster-cbsqgcswk6ou.ap-southeast-1.rds.amazonaws.com
MYSQL_PORT=3306
MYSQL_USER=feng.hu
MYSQL_PASSWORD=tUZ$gVLCG*52T!RqhhkS
MYSQL_DATABASE=lita_project

# 飞书 token：测试/生产统一从 Lita 平台 API 获取，后端每 30 分钟定时刷新
LITA_USER_TOKEN=J+7BnxSkzw7YD9B8xGvxr1SqIMkWhRaagTBix9wtCIdt4AabslaerjaO8CdqoX1b
# 机器人初始化时写入工位 .opencode/.env 的 Lita 用户令牌（未配置时回退 LITA_USER_TOKEN）
WORKER_LITA_USER_TOKEN=J+7BnxSkzw7YD9B8xGvxr01Kg3rxtw1XxtPKI7kF9Wht4AabslaerjaO8CdqoX1b
# 可选：Lita API 地址，默认 https://api.cinta.team（测试环境用 https://api.test.cinta.team）
# LITA_API_HOST=

# 兜底（未配置 LITA_USER_TOKEN 时）：飞书自建应用凭据
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 检查脚本根目录：登记检查时扫描该目录下所有 .check.ts 供自动联想（存相对路径）
CHECK_SCRIPTS_DIR=/home/ecs-user/work/lita-scripts

# 图片上传后的本地根目录：经 http://{host}/images/{image-path} 对外访问
DIR_IMAGE_WEBROOT=/home/ecs-user/work/webroot-images

# 访问域名（nginx 转发）：work.cinta.team 统一使用 http（ALB 443 未配 work 证书，https 不可用）
APP_URL=http://work.cinta.team
API_URL=http://work.cinta.team/api
DB_HOST="nlb-uwuxjiiunnw4j0exrn.ap-southeast-1.nlb.aliyuncs.com"
DB_PORT="13774"
DB_USER="postgres"
DB_PASSWORD=
# DB_PASSWORD / PROJECT_PG_PASSWORD 由部署环境注入，不写入仓库
DB_NAME="lita_project"
MYSQL_IGNORE_TABLES="projects_bak_enumfix"
PROJECT_PG_HOST="nlb-uwuxjiiunnw4j0exrn.ap-southeast-1.nlb.aliyuncs.com"
PROJECT_PG_PORT="13774"
PROJECT_PG_USER="postgres"
PROJECT_PG_PASSWORD=
PROJECT_PG_DATABASE="project_dev"
