# 服务端口
PORT=3000
NODE_ENV=development

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ai_pmp

# 飞书 token：测试/生产统一从 Lita 平台 API 获取，后端每 30 分钟定时刷新
LITA_USER_TOKEN=
# 可选：Lita API 地址，默认 https://api.cinta.team（测试环境用 https://api.test.cinta.team）
# LITA_API_HOST=

# 兜底（未配置 LITA_USER_TOKEN 时）：飞书自建应用凭据
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 项目同步源（多维表格链接，需带 table 参数，可选 view 参数）
# FEISHU_PROJECT_SOURCE_URL=https://xxx.feishu.cn/wiki/<token>?table=<tbl>&view=<vew>

# 检查脚本根目录：登记检查时扫描该目录下所有 .check.ts 供自动联想（存相对路径）
# CHECK_SCRIPTS_DIR=/path/to/scripts

# 访问域名（设置页展示，可选）
# APP_URL=http://localhost:5173
# API_URL=http://localhost:3000/api
