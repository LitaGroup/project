# 服务端口
PORT=3100
NODE_ENV=development

# 业务数据库 PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=project
# 云端 PostgreSQL 需要 TLS 时开启
# DB_SSL=true

# 历史 MySQL 连接仅用于一次性数据导入：pnpm -C backend db:migrate:mysql
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=
# MYSQL_DATABASE=project
# 源库存在确认无需迁移的历史备份表时，可逗号分隔显式跳过
# MYSQL_IGNORE_TABLES=projects_bak_enumfix

# 知识库 PostgreSQL（需已安装 pgvector 扩展；默认复用上方 DB_* 业务库配置）
# 如需独立知识库，可单独设置以下 PROJECT_PG_*；未启用时文档保留业务库正文兜底
# 加载顺序：进程环境变量 > backend/.env > ~/.env
# PROJECT_PG_HOST=
# PROJECT_PG_PORT=5432
# PROJECT_PG_USER=
# PROJECT_PG_PASSWORD=
# PROJECT_PG_DATABASE=

# 知识库向量检索（OpenAI 兼容 /embeddings；未配置时搜索降级为全文检索）
PROJECT_KNOWLEDGE_EMBEDDING_BASE_URL=
PROJECT_KNOWLEDGE_EMBEDDING_API_KEY=
PROJECT_KNOWLEDGE_EMBEDDING_MODEL=
PROJECT_KNOWLEDGE_EMBEDDING_DIMENSIONS=1024
# 纯向量召回的最低余弦相似度（0..1，默认 0.65；0 表示不过滤）
PROJECT_KNOWLEDGE_SEARCH_VECTOR_MIN_SIMILARITY=0.65

# 飞书 token：测试/生产统一从 Lita 平台 API 获取，后端每 30 分钟定时刷新
LITA_USER_TOKEN=
# 机器人初始化时写入工位 .opencode/.env 的 Lita 用户令牌（未配置时回退 LITA_USER_TOKEN）；
# 同一文件还会注入 LITA_PROJECT_TOKEN（机器人独立令牌，访问项目平台 .md 接口）
WORKER_LITA_USER_TOKEN=
# 可选：Lita API 地址，默认 https://api.cinta.team（测试环境用 https://api.test.cinta.team）
# LITA_API_HOST=

# 兜底（未配置 LITA_USER_TOKEN 时）：飞书自建应用凭据
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 项目同步源（多维表格链接，需带 table 参数，可选 view 参数）
# FEISHU_PROJECT_SOURCE_URL=https://xxx.feishu.cn/wiki/<token>?table=<tbl>&view=<vew>

# 检查脚本根目录：登记检查时扫描该目录下所有 .check.ts 供自动联想（存相对路径）
# CHECK_SCRIPTS_DIR=/path/to/scripts

# 图片上传后的本地根目录：经 http://{host}/images/{image-path} 对外访问（默认 <项目根>/images）
# DIR_IMAGE_WEBROOT=/path/to/images

# 导出产物的本地根目录：每次运行输出到 {exportId}/{runId}/，经 http://{host}/export-files/... 对外访问（默认 <项目根>/export-files）
# DIR_EXPORT_WEBROOT=/path/to/export-files

# 通用文件上传后的本地根目录：经 http://{host}/files/{file-path} 公开访问（默认 <项目根>/files）
# DIR_FILE_WEBROOT=/path/to/files

# 飞书群机器人 webhook 兜底地址：项目未配置 feishuWebhook 时，任务运行结果推送到该群（调试用）
# FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxx

# GitHub 集成：个人访问令牌（Fine-grained 选 Resource owner=LitaGroup + Contents 只读；
# Classic 勾 repo）。用于仓库搜索、分支联想与每分钟轮询项目登记分支的新提交/合并
# GITHUB_TOKEN=
# GitHub 组织名（默认 LitaGroup）
# GITHUB_ORG=LitaGroup

# 访问域名（设置页展示，可选）
# APP_URL=http://localhost:5273
# API_URL=http://localhost:3100/api

# APP 自动化测试：appium-agent 连接 WebSocket 的鉴权 token（与 agent 的 AGENT_TOKEN 一致）
# AGENT_TOKEN=

# APP 测试远程执行默认超时（毫秒，默认 600000=10min），单次运行可在任务消息里覆盖
# APP_RUN_TIMEOUT_MS=600000

# 用户系统：飞书网页登录（复用上方 FEISHU_APP_ID/SECRET，需在飞书后台为该应用
# 开启「网页授权登录」并登记重定向 URL：{APP_URL}/api/auth/feishu/callback）
# JWT 签名密钥（登录会话 Cookie，7 天有效；未配置时开发环境用内置默认值，生产必须配置）
# AUTH_JWT_SECRET=
# 登录 Cookie 的 Secure 标记（https 部署时设为 true，内网 http 保持关闭）
# COOKIE_SECURE=true

# 公共 Agent 访问令牌：供多个公共 Agent 共用的 agent 访问令牌（权限与管理员等同），
# 仅用于 /api/...*.md 端点鉴权（X-Agent-Token 头或 ?token= 参数），操作人记录为「公共 Agent」；
# 未配置时禁用。生成：openssl rand -hex 24（建议加 pmpub_ 前缀）
# PUBLIC_AGENT_TOKEN=

# 多语言文案来源固定为 Lita 平台接口 POST {LITA_API_HOST}/basic-common/v1/word/sheet（复用上方 LITA_API_HOST，无需额外配置）

# ===== 任务处理中心（FEATURE-02）=====
# 机器人工位根目录（执行器机器上的路径约定，workdir = {WORKER_BASE_DIR}/worker/{id}）
# WORKER_BASE_DIR=/data/opencode-workers
# 技能库仓库（机器人技能选择来源，默认 http://gitea.cinta.team/docs/skills）
# WORKER_SKILL_REPO_URL=http://gitea.cinta.team/docs/skills
# 规范库仓库（机器人规范选择来源，默认 http://gitea.cinta.team/docs/standard）
# WORKER_STANDARD_REPO_URL=http://gitea.cinta.team/docs/standard
# 注：调度机器人已并入机器人（系统机器人 id<1000），任务识别与 PROMPT 优化统一走 opencode 执行器，无需进程内 PI Agent 配置
